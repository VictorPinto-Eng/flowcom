# String de conexão para o banco de dados
# Substitua pelos seus dados
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/flowcom?schema=public&options=-c%20timezone=UTC"

# Chave da API Resend para envio de emails
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email remetente para envio de emails
# Em produção, use um domínio/remetente verificado no Resend
RESEND_FROM_EMAIL=no-reply@seudominio.com

# Chave secreta para assinar tokens JWT
# Gere com: openssl rand -hex 64
JWT_SECRET=coloque-um-segredo-forte-aqui

# URL pública da aplicação usada nos links de ativação e recuperação de senha
NEXT_PUBLIC_APP_URL=http://localhost:3000
